# ─────────────────────────────────────────────────────────────────────────────
# Expensio Backend — Environment Variables Reference
# Deploy target: Render (backend) + Supabase (database)
# Copy this file to .env for local dev. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Local:       jdbc:postgresql://localhost:5432/expensio
# Supabase:    jdbc:postgresql://db.<ref>.supabase.co:5432/postgres
DB_URL=jdbc:postgresql://localhost:5432/expensio
DB_USERNAME=expensio
DB_PASSWORD=changeme

# ── Spring Profile ────────────────────────────────────────────────────────────
# Local: dev | Render: prod
SPRING_PROFILES_ACTIVE=dev

# ── Server ────────────────────────────────────────────────────────────────────
# Render injects PORT automatically. Leave as 8080 locally.
PORT=8080

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local:       http://localhost:5173
# Production:  https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173
